# CareCircle Environment Configuration Example
# Copy this file to .env and adjust values for your environment

# App settings
APP_NAME=CareCircle
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=carecircle-hackathon-change-this-in-production-use-a-strong-secret-key-32chars
HOST=0.0.0.0
PORT=8000

# Google Cloud Firestore settings
# If FIRESTORE_PROJECT_ID is empty or USE_MOCK_FIRESTORE=true, in-memory local Firestore is used.
FIRESTORE_PROJECT_ID=
USE_MOCK_FIRESTORE=true
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini API settings
# Required for real AI extraction/drafting. If omitted or GEMINI_API_KEY=mock, safe fallback parser is used.
GEMINI_API_KEY=mock
GEMINI_MODEL=gemini-1.5-flash

# Security & Passcode settings
PASSCODE_SALT_ROUNDS=12
MAX_PASSCODE_ATTEMPTS=5
PASSCODE_LOCKOUT_SECONDS=300
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
